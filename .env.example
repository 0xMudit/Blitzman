# ---------------------------------------------------------------------------
# Blitzman local development
# Copy to .env (or export these) before running the API.
# Every value below has a safe development default except the secrets.
# ---------------------------------------------------------------------------

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Auth — change these outside local development.
JWT_SECRET=dev-jwt-secret-change-me
PLAYBACK_SECRET=dev-playback-secret-change-me

# Data
# Leave DATABASE_URL empty to use embedded PGlite (zero setup, stored in .data/pglite).
# DATABASE_URL=postgres://blitzman:blitzman@localhost:5432/blitzman
PGLITE_DIR=.data/pglite

# Playback
# How many simultaneous streams one account may hold open.
MAX_CONCURRENT_STREAMS=2
# Lifetime of a signed playback token, in seconds.
PLAYBACK_TTL_SECS=120
# Edge PoPs the API steers playback sessions toward, in preference order.
EDGE_URLS=http://localhost:4100,http://localhost:4101

# Edge PoPs (apps/edge)
# Two local PoPs are started by `npm run dev`: edge-iad on 4100 and edge-fra on 4101.
# The edge reads WEB_ORIGIN (above) for CORS.
# Must match the API's PLAYBACK_SECRET so the edge can verify playback tokens.
PLAYBACK_SECRET=dev-playback-secret-change-me
# Signs the short-lived HttpOnly edge cookie. Shared by all PoPs.
EDGE_SESSION_SECRET=dev-edge-secret-change-me
# Edge cookie lifetime, in seconds. The player rotates it before expiry.
EDGE_SESSION_TTL_SECS=180
# Per-PoP byte cache. Segments larger than half of this are proxied without caching.
EDGE_CACHE_BYTES=100663296
EDGE_UPSTREAM_TIMEOUT_MS=20000
# Set true when serving the web app over HTTPS.
EDGE_COOKIE_SECURE=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
