# ---------------------------------------------------------------------------
# Blitzman local development
# Copy to .env (or export these) before running the API.
# Every value below has a safe development default except the secrets.
# ---------------------------------------------------------------------------

# API
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Auth — change these outside local development.
JWT_SECRET=dev-jwt-secret-change-me
PLAYBACK_SECRET=dev-playback-secret-change-me

# Data
# Leave DATABASE_URL empty to use embedded PGlite (zero setup, stored in .data/pglite).
# DATABASE_URL=postgres://blitzman:blitzman@localhost:5432/blitzman
PGLITE_DIR=.data/pglite

# Playback
# How many simultaneous streams one account may hold open.
MAX_CONCURRENT_STREAMS=2
# Lifetime of a signed playback token, in seconds.
PLAYBACK_TTL_SECS=120

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
